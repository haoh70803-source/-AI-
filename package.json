{
  "name": "ai-content-center",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm exec turbo dev",
    "dev:real": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm exec turbo dev",
    "dev:web": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm --filter @content-center/web dev",
    "dev:worker": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm --filter @content-center/worker dev",
    "dev:up": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-up.ps1",
    "dev:down": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-down.ps1",
    "doctor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "dev:asr": "services\\local-asr\\.venv\\Scripts\\python.exe services\\local-asr\\server.py",
    "asr:fixtures": "services\\local-asr\\.venv\\Scripts\\python.exe services\\local-asr\\benchmark\\generate_fixtures.py",
    "asr:benchmark": "services\\local-asr\\.venv\\Scripts\\python.exe services\\local-asr\\benchmark\\run_benchmark.py",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "node scripts/runtime-env.mjs LOCAL_TEST .env.local-test pnpm exec turbo test --concurrency=1",
    "test:isolated": "pnpm test",
    "test:e2e": "node scripts/runtime-env.mjs LOCAL_TEST .env.local-test pnpm --filter @content-center/web test:e2e",
    "test:e2e:isolated": "pnpm test:e2e",
    "build": "node scripts/local-release.mjs build",
    "db:generate": "pnpm --filter @content-center/db db:generate",
    "db:migrate": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm --filter @content-center/db db:migrate",
    "db:studio": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm --filter @content-center/db db:studio",
    "admin:bootstrap": "dotenv -e .env -- pnpm --filter @content-center/web admin:bootstrap",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d",
    "infra:test:down": "docker compose -f docker-compose.test.yml down",
    "dev:review": "node scripts/local-web.mjs review",
    "review:check": "node scripts/local-web.mjs review check",
    "test:local-env": "node --test scripts/local-profile.test.mjs",
    "dev:daily": "node scripts/local-web.mjs daily",
    "daily:check": "node scripts/local-web.mjs daily check",
    "build:legacy": "node scripts/runtime-env.mjs LOCAL_REAL .env.local-real pnpm exec turbo build",
    "release:build": "node scripts/local-release.mjs build",
    "release:check": "node scripts/local-release.mjs check",
    "release:start": "node scripts/local-release.mjs start",
    "test:release": "node --test scripts/release*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.9.1",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
