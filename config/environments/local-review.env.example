# Fresh developer profile. Copy to .env.local-review (ignored).
# Provision a separate database and storage before starting; no automatic migration.
ENVIRONMENT_ID=LOCAL_REVIEW
APP_ENV=local-review
DATABASE_URL=postgresql://replace-user:replace-password@127.0.0.1:55438/content_center_12_review?schema=public
APP_URL=http://127.0.0.1:3022
AUTH_COOKIE_PREFIX=content-center-12-review
AUTH_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=
STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=http://127.0.0.1:19020
S3_REGION=us-east-1
S3_BUCKET=content-center-review
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://127.0.0.1:1/0
WORKER_MODE=disabled
FREE_WORKER_MODE=false
LOCAL_REVIEW_OFFLINE=true
EXTERNAL_CALLS_DISABLED=true
SYSTEM_MANAGED_PROVIDERS=false
MOCK_MODE=false
DEMO_AUTO_LOGIN=false
INTERNAL_SIGNUP_ENABLED=false
AIHOT_PUBLIC_NEWS_ENABLED=false
FEISHU_WIKI_SYNC_ENABLED=false
