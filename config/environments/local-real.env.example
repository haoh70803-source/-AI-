# Copy to .env.local-real for the reviewed Docker Compose runtime.
# The 55432 project database is the persistent content-center_postgres_data volume, not the native temp clusters.
ENVIRONMENT_ID=LOCAL_REAL
APP_ENV=local-real
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://content_center:content_center_dev@127.0.0.1:55432/content_center?schema=public
REDIS_URL=redis://127.0.0.1:6379
STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=content-center
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SYSTEM_MANAGED_PROVIDERS=false
MOCK_MODE=false
RUNTIME_GUARD=DOCKER_COMPOSE
WORKER_HEALTH_URL=http://127.0.0.1:3010
WORKER_HEALTH_PORT=3010
LOCAL_ASR_ENDPOINT=http://127.0.0.1:8765
