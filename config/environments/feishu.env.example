# Feishu environment fragment; merge only into an explicitly reviewed runtime profile.
# It is not a complete application environment. No existing credentials are changed.
# App ID/App Secret are stored by the existing server-side encrypted Feishu connection UI.
# Keep the existing INTEGRATION_ENCRYPTION_KEY; do not regenerate it for this integration.

# Review/offline example: prevents Feishu requests, scheduled sync and external cache reuse.
EXTERNAL_CALLS_DISABLED=true
LOCAL_REVIEW_OFFLINE=true

# Enable only after the additive Wiki migration has been approved/applied and
# the runtime has been restarted with a fully generated Prisma client.
FEISHU_WIKI_SYNC_ENABLED=false

# Real authorized validation requires a reviewed online profile with these flags false.
# Do not override the repository's daily/review profile guard to perform live reads.
