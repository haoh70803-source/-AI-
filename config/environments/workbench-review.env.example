# Secret-free handoff reference; not a provisioned runtime profile.
ENVIRONMENT_ID=LOCAL_REVIEW
LOCAL_REVIEW_OFFLINE=true
FREE_EXPERIENCE_MODE=false
APP_URL=http://127.0.0.1:3030
PORT=3030
DATABASE_URL=<private connection to isolated content_center_upgrade_review on port 55436>
REDIS_URL=<dedicated private review Redis URL>
STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=<your region>
S3_BUCKET=<your isolated bucket>
S3_ACCESS_KEY_ID=<private access key>
S3_SECRET_ACCESS_KEY=<private secret key>
S3_FORCE_PATH_STYLE=true
AIHOT_PUBLIC_NEWS_ENABLED=false
AIHOT_NEWS_CACHE_ROOT=<absolute private persistent cache directory>
# Worker-disable policy comes from existing local profiles.
# Do not copy daily credentials, enable paid providers, reset, or seed.
AUTH_SECRET=<existing authorized private auth secret>
INTEGRATION_ENCRYPTION_KEY=<existing authorized private encryption key>
AUTH_COOKIE_PREFIX=<distinct review prefix required by local-profile.mjs>
EXTERNAL_CALLS_DISABLED=true
WORKER_MODE=disabled
FREE_WORKER_MODE=false
SYSTEM_MANAGED_PROVIDERS=false
MOCK_MODE=false
INTERNAL_SIGNUP_ENABLED=false
DEMO_AUTO_LOGIN=false
# APP_URL/PORT above describe release review; the legacy private profile URL
# must separately match validateReview before the release launcher selects 3030.
