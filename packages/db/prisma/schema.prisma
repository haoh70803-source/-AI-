model FeishuConnection {
  id String @id @default(cuid())
  workspaceId String @unique
  createdById String
  appId String
  encryptedSecret String
  enabled Boolean @default(false)
  autoSync Boolean @default(true)
  revision Int @default(1)
  leaseOwner String?
  leaseUntil DateTime?
  lastAttemptAt DateTime?
  lastSyncedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents FeishuDocument[]
  @@unique([id, workspaceId])
}
model FeishuDocument {
  id String @id @default(cuid())
  workspaceId String
  connectionId String
  sourceItemId String @unique
  kind String
  token String
  documentId String?
  originalUrl String
  category String
  state String @default("PENDING")
  revision Int @default(1)
  contentHash String?
  remoteRevision String?
  checkedAt DateTime?
  syncedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  connection FeishuConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sourceItem SourceItem @relation(fields: [sourceItemId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
