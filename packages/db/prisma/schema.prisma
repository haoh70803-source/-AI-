  aiRun AIRun? @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  sharedArtifacts Artifact[]

  @@unique([sessionId, requestKey])
  @@unique([sessionId, version])
  @@index([workspaceId, requestedById, savedAt])
  @@index([sessionId, createdAt])
}

