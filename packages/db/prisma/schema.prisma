generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum SystemRole {
  SYSTEM_ADMIN
  USER
}

enum IntegrationProvider {
  WEB_SEARCH
  REDFOX
  DOUBAO_ASR
  TRANSCRIPTION
  LLM
  PUBLISHING
  STORAGE
}

enum IntegrationStatus {
  CONFIGURED
  UNCONFIGURED
  ERROR
  DISABLED
  MOCK
}

enum SourceType {
  TEXT
  URL
  VIDEO
  AUDIO
  IMAGE
  DOCUMENT
}

enum SourcePlatform {
  GENERIC
  DOUYIN
  XIAOHONGSHU
  WECHAT
  BILIBILI
  YOUTUBE
  TIKTOK
  OTHER
}

enum ContentIdeaStatus {
  INBOX
  READY
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TrendPlatform {
  DOUYIN
  XIAOHONGSHU
  GLOBAL
}

enum TrendType {
  HOT
  SURGING
  DARK_HORSE
}

enum SourceItemStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum IngestJobType {
  EXTRACT_TEXT
  FETCH_URL
  TRANSCRIBE
  PROCESS_MEDIA
  ANALYZE_MATERIAL
  DISTILL_MATERIAL
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ProviderMode {
  REAL
  MOCK
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
}

enum ArtifactType {
  TEXT
}

enum AssetStatus {
  REMOTE
  DOWNLOADING
  STORED
  FAILED
}

enum ContentProjectStatus {
  DRAFT
  RESEARCHING
  BRIEF_READY
  WRITING
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ProjectSourceRole {
  REFERENCE
  EVIDENCE
  INSPIRATION
  OWN_MATERIAL
}

enum EvidenceType {
  FACT
  VIEWPOINT
  CASE
  DATA
  QUOTE
  EXPERIENCE
  QUESTION
  OTHER
  ORGANIZATION
  PRODUCT_SERVICE
  COMMERCIAL_COMMITMENT
}

enum EvidenceOwnership {
  OWN
  EXTERNAL
  UNKNOWN
}

enum EvidenceStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PromptType {
  ANALYZE_MATERIAL
  ANALYZE_BENCHMARK
  DISTILL_MATERIAL
  UNIFIED_CREATIVE_ANALYSIS
  ANALYZE_SOURCES
  EXTRACT_EVIDENCE
  GENERATE_ANGLES
  GENERATE_BRIEF
  GENERATE_MOTHER_CONTENT
  REWRITE_SELECTION
  SHORTEN
  EXPAND
  ADD_PERSONAL_VIEW
  HUMANIZE
  ADAPT_PLATFORM
  GENERATE_DEEP_CONTENT_PACKAGE
  REVIEW_PLATFORM_CONTENT
  GENERATE_TOPIC_CANDIDATES
  GENERATE_TODAY_RECOMMENDATIONS
  PROJECT_ASSISTANT
  MATERIAL_KNOWLEDGE_EXTRACTION
  METHOD_SUGGESTION_FROM_RESEARCH
  CREATOR_PROFILE_SUGGESTION
}

enum MaterialAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BenchmarkStudyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BenchmarkCollectionRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum MaterialAnalysisOrigin {
  AI
  HUMAN
}

enum MaterialDistillationMode {
  COMPREHENSIVE
  COPYWRITING
}

enum MaterialDistillationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum UnifiedCreativeAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum RecommendationMode {
  DETERMINISTIC
  AI_ASSISTED
}

enum RecommendationItemStatus {
  NEW
  SAVED
  STARTED
  DISMISSED
}

enum RecommendationEvidenceType {
  TREND
  BENCHMARK_CONTENT
  CONTENT_IDEA
  SOURCE_ITEM
  PROJECT
  CREATOR_PROFILE
}

enum ReviewResult {
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
  CANCELLED
}

enum AIRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum Platform {
  DOUYIN
  XIAOHONGSHU
  WECHAT_MOMENTS
  WECHAT_CHANNELS
  WECHAT_OFFICIAL
}

enum PlatformVariantStatus {
  DRAFT
  READY
  STALE
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum DeepContentPackageStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

enum MotherContentOrigin {
  HUMAN
  KIMI
  GPT_WEB
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  STOPPED
}

enum DraftRevisionOrigin {
  HUMAN
  AI
  GPT_WEB
}

enum MethodStatus {
  SAVED
  TRIAL
  CORE
  DISABLED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MethodSuggestionType {
  OPENING
  STRUCTURE
  VIEWPOINT_PROGRESSION
  CASE_USAGE
  EVIDENCE_USAGE
  ENDING
  RHYTHM
  BOUNDARY
}

enum MethodSuggestionStability {
  LIMITED
  STABLE
}

enum CreatorProfileSuggestionType {
  CORE_TOPIC
  PERSONAL_VIEW
  HOOK_PREFERENCE
  STRUCTURE_PREFERENCE
  PREFERRED_STYLE
  FORBIDDEN_STYLE
  EXAMPLE_PHRASE
}

enum CreationFeedbackOutcome {
  DIRECTLY_USED
  USED_AFTER_EDIT
  NOT_USED
}

enum MethodUsageFeedbackRating {
  HELPFUL
  NEUTRAL
  NOT_SUITABLE
}

enum CanvasObjectType {
  TEXT
  MATERIAL_REFERENCE
  IMAGE_REFERENCE
}

enum CanvasSnapshotReason {
  MANUAL_CHECKPOINT
  BEFORE_DELETE
  AI_INPUT
}

enum CanvasRelationType {
  GENERATED_FROM
}

enum CanvasReferencePurpose {
  PRIMARY
  CONTEXT
}

model User {
  researchSessions ResearchSession[]
  researchRuns ResearchRun[]
  researchObjectPreferences ResearchObjectPreference[]
  id                      String               @id @default(cuid())
  name                    String
  email                   String               @unique
  emailVerified           Boolean              @default(false)
  image                   String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  systemRole              SystemRole           @default(USER)
  disabledAt              DateTime?
  sessions                Session[]
  accounts                Account[]
  workspaceMemberships    WorkspaceMember[]
  auditLogs               AuditLog[]
  createdSources          SourceItem[]         @relation("SourceCreatedBy")
  requestedIngestJobs     IngestJob[]          @relation("IngestRequestedBy")
  createdCollections      Collection[]         @relation("CollectionCreatedBy")
  apiUsages               ApiUsage[]
  createdProjects         ContentProject[]     @relation("ProjectCreatedBy")
  createdEvidenceItems    EvidenceItem[]       @relation("EvidenceCreatedBy")
  confirmedEvidenceItems  EvidenceItem[]       @relation("EvidenceConfirmedBy")
  rejectedEvidenceItems   EvidenceItem[]       @relation("EvidenceRejectedBy")
  createdBriefs           CreativeBrief[]      @relation("BriefCreatedBy")
  createdMotherContent    MotherContent[]      @relation("MotherContentCreatedBy")
  creatorProfiles         CreatorProfile[]
  aiRuns                  AIRun[]              @relation("AIRunUser")
  createdPlatformVariants PlatformVariant[]    @relation("PlatformVariantCreatedBy")
  createdDeepPackages     DeepContentPackage[] @relation("DeepContentPackageCreatedBy")
  reviewRecords           ReviewRecord[]       @relation("ReviewRecordReviewer")
  createdPublishTasks     PublishTask[]         @relation("PublishTaskCreatedBy")
  publishedTasks          PublishTask[]         @relation("PublishTaskPublisher")
  createdBenchmarkAccounts BenchmarkAccount[]   @relation("BenchmarkAccountCreatedBy")
  createdContentIdeas     ContentIdea[]          @relation("ContentIdeaCreatedBy")
  createdRecommendationBatches RecommendationBatch[] @relation("RecommendationBatchCreatedBy")
  createdMaterialAnalyses MaterialAnalysis[]           @relation("MaterialAnalysisCreatedBy")
  createdMaterialDistillations MaterialDistillation[] @relation("MaterialDistillationCreatedBy")
  createdBenchmarkStudies BenchmarkStudy[]             @relation("BenchmarkStudyCreatedBy")
  requestedBenchmarkCollectionRuns BenchmarkCollectionRun[]   @relation("BenchmarkCollectionRunRequestedBy")
  createdUnifiedCreativeAnalyses UnifiedCreativeAnalysis[] @relation("UnifiedCreativeAnalysisCreatedBy")
  ownedMethodAssets       MethodAsset[]                @relation("MethodAssetOwner")
  editedMethodVersions    MethodVersion[]              @relation("MethodVersionEditedBy")
  selectedProjectMethods  ProjectMethodSelection[]     @relation("ProjectMethodSelectionUser")
  methodUsages            MethodUsage[]                @relation("MethodUsageUser")
  creationFeedbacks       CreationFeedback[]           @relation("CreationFeedbackUser")
  methodUsageFeedbacks    MethodUsageFeedback[]        @relation("MethodUsageFeedbackUser")
  createdCanvasObjects    CanvasObject[]               @relation("CanvasObjectCreatedBy")
  updatedCanvasObjects    CanvasObject[]               @relation("CanvasObjectUpdatedBy")
  deletedCanvasObjects    CanvasObject[]               @relation("CanvasObjectDeletedBy")
  createdCanvasSnapshots  CanvasObjectSnapshot[]       @relation("CanvasSnapshotCreatedBy")
  createdCanvasRelations  CanvasRelation[]             @relation("CanvasRelationCreatedBy")
  createdDraftBranches    DraftBranch[]                 @relation("DraftBranchCreatedBy")
  updatedDraftBranches    DraftBranch[]                 @relation("DraftBranchUpdatedBy")
  deletedDraftBranches    DraftBranch[]                 @relation("DraftBranchDeletedBy")
  createdDraftRevisions   DraftRevision[]               @relation("DraftRevisionCreatedBy")
  createdAssistantThreads AssistantThread[]             @relation("AssistantThreadCreatedBy")
  createdArtifacts        Artifact[]                    @relation("ArtifactCreatedBy")
  projectFolders                   ProjectFolder[]
  projectPreferences               UserProjectPreference[]
  createdCanvasGenerateRuns CanvasGenerateRun[]          @relation("CanvasGenerateRunCreatedBy")
  generatedMethodSuggestions MethodSuggestion[]          @relation("MethodSuggestionGeneratedBy")
  reviewedMethodSuggestions  MethodSuggestion[]          @relation("MethodSuggestionReviewedBy")
  generatedProfileSuggestions CreatorProfileSuggestion[] @relation("ProfileSuggestionGeneratedBy")
  reviewedProfileSuggestions  CreatorProfileSuggestion[] @relation("ProfileSuggestionReviewedBy")

  @@index([systemRole])
  @@index([disabledAt])
}

model Session {
  activeWorkspaceId String?
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Workspace {
  feishuConnection FeishuConnection?
  videoAccounts VideoAccount[]
  videoMetrics VideoDailyMetric[]
  videoContents VideoContent[]
  videoTasks VideoTask[]
  contentPolicy WorkspaceContentPolicy?
  contentTopics ContentTopic[]
  knowledgeEntries KnowledgeEntry[]
  factRecords FactRecord[]
  ipContextVersions IPContextVersion[]

  disabledAt DateTime?
  researchSessions ResearchSession[]
  researchRuns ResearchRun[]
  researchObjectPreferences ResearchObjectPreference[]
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  members             WorkspaceMember[]
  integrations        IntegrationConfig[]
  auditLogs           AuditLog[]
  sourceItems         SourceItem[]
  ingestJobs          IngestJob[]
  transcripts         Transcript[]
  contentTags         ContentTag[]
  collections         Collection[]
  sourceAssets        SourceAsset[]
  sourceUnderstandings SourceUnderstanding[]
  apiUsages           ApiUsage[]
  contentProjects     ContentProject[]
  evidenceItems       EvidenceItem[]
  creativeBriefs      CreativeBrief[]
  motherContents      MotherContent[]
  creatorProfiles     CreatorProfile[]
  promptTemplates     PromptTemplate[]
  platformTemplates   PlatformTemplate[]
  platformVariants    PlatformVariant[]
  deepContentPackages DeepContentPackage[]
  aiRuns              AIRun[]
  reviewRecords       ReviewRecord[]
  publishTasks        PublishTask[]
  benchmarkAccounts   BenchmarkAccount[]
  contentIdeas        ContentIdea[]
  trendSnapshots      TrendSnapshot[]
  benchmarkContentSnapshots BenchmarkContentSnapshot[]
  benchmarkStudies    BenchmarkStudy[]
  benchmarkCollectionRuns   BenchmarkCollectionRun[]
  recommendationBatches RecommendationBatch[]
  recommendationItems RecommendationItem[]
  recommendationEvidence RecommendationEvidence[]
  materialAnalyses       MaterialAnalysis[]
  materialDistillations  MaterialDistillation[]
  unifiedCreativeAnalyses UnifiedCreativeAnalysis[]
  methodAssets           MethodAsset[]
  creationFeedbacks      CreationFeedback[]
  canvasObjects          CanvasObject[]
  canvasSnapshots        CanvasObjectSnapshot[]
  canvasRelations        CanvasRelation[]
  canvasMaterialReferences CanvasMaterialReference[]
  draftBranches           DraftBranch[]
  draftRevisions          DraftRevision[]
  assistantThreads        AssistantThread[]
  artifacts               Artifact[]
  projectFolders            ProjectFolder[]
  userProjectPreferences    UserProjectPreference[]
  canvasGenerateRuns      CanvasGenerateRun[]
  methodSuggestions       MethodSuggestion[]
  creatorProfileSuggestions CreatorProfileSuggestion[]
}

model WorkspaceMember {
  disabledAt DateTime?
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model IntegrationConfig {
  id                   String              @id @default(cuid())
  workspaceId          String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(UNCONFIGURED)
  configured           Boolean             @default(false)
  publicConfig         Json?
  encryptedConfig      String?
  lastFour             String?
  encryptionKeyVersion Int                 @default(1)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model SourceItem {
  feishuDocument FeishuDocument?
  id             String           @id @default(cuid())
  workspaceId    String
  createdById    String
  sourceType     SourceType
  sourcePlatform SourcePlatform   @default(GENERIC)
  sourceUrl      String?
  canonicalUrl   String?
  externalId     String?
  sourceProvider String?
  title          String?
  author         String?
  description    String?
  thumbnailUrl   String?
  rawText        String?
  status         SourceItemStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("SourceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  ingestJobs     IngestJob[]
  transcript     Transcript?
  sourceUnderstanding SourceUnderstanding?
  tags           SourceItemTag[]
  collections    CollectionItem[]
  assets         SourceAsset[]
  projects       ProjectSource[]
  evidenceItems  EvidenceItem[]
  ideaReferences ContentIdeaReference[]
  materialAnalyses MaterialAnalysis[]
  materialDistillations MaterialDistillation[]
  methodVersionsFromSource MethodVersion[] @relation("MethodVersionSourceItem")
  benchmarkStudySamples BenchmarkStudySample[]
  canvasMaterialReferences CanvasMaterialReference[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, canonicalUrl])
  @@unique([workspaceId, sourcePlatform, externalId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, sourcePlatform])
}

enum SourceUnderstandingStatus {
  NOT_STARTED
  RUNNING
  COMPLETED
  FAILED
}

model SourceUnderstanding {
  id           String @id @default(cuid())
  workspaceId  String
  sourceItemId String @unique
  assetId      String
  sourceType   SourceType
  status       SourceUnderstandingStatus @default(NOT_STARTED)
  runId        String?
  text         String?
  pages        Json?
  provider     String?
  model        String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model SourceAsset {
  id             String      @id @default(cuid())
  workspaceId    String
  sourceItemId   String
  assetType      AssetType
  sourceProvider String
  remoteUrl      String?
  storageKey     String?
  mimeType       String?
  sizeBytes      BigInt?
  status         AssetStatus @default(REMOTE)
  metadata       Json?
  storedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem     SourceItem  @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  canvasMaterialReferences CanvasMaterialReference[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, sourceItemId])
  @@index([sourceItemId, status])
}

model ApiUsage {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  provider          String
  operation         String
  requestId         String
  providerRequestId String?
  success           Boolean
  units             Int       @default(1)
  cost              Decimal?
  inputTokens       Int?
  outputTokens      Int?
  metadata          Json?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, operation])
  @@index([requestId])
}

model IngestJob {
  id            String        @id @default(cuid())
  workspaceId   String
  sourceItemId  String
  requestedById String
  jobType       IngestJobType
  provider      String
  providerMode  ProviderMode
  status        JobStatus     @default(QUEUED)
  progress      Int           @default(0)
  attempt       Int           @default(0)
  maxAttempts   Int           @default(3)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem    SourceItem    @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  requestedBy   User          @relation("IngestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([sourceItemId, createdAt])
}

model Transcript {
  id           String       @id @default(cuid())
  workspaceId  String
  sourceItemId String       @unique
  provider     String
  providerMode ProviderMode
  language     String?
  durationMs   Int?
  fullText     String
  segments     Json
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem   @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  methodVersions MethodVersion[] @relation("MethodVersionSourceTranscript")

  @@index([workspaceId, createdAt])
}

model ContentTag {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceItems SourceItemTag[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, name])
}

model SourceItemTag {
  sourceItemId String
  tagId        String
  createdAt    DateTime   @default(now())
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  tag          ContentTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sourceItemId, tagId])
  @@index([tagId])
}

model Collection {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceItems CollectionItem[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model CollectionItem {
  collectionId String
  sourceItemId String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sourceItem   SourceItem @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)

  @@id([collectionId, sourceItemId])
  @@index([sourceItemId])
}

model ContentProject {
  ipContextSnapshot Json?
  originTopic ContentTopic?
  researchSessions ResearchSession[]
  id                  String               @id @default(cuid())
  workspaceId         String
  createdById         String
  clientRequestId          String?
  creationModel            Json?
  creationRequestHash      String?
  creatorProfileId    String?
  title               String
  description         String?
  goal                String?
  audience            String?
  status              ContentProjectStatus @default(DRAFT)
  primaryDraftBranchId String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User                 @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  creatorProfile      CreatorProfile?      @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  sources             ProjectSource[]
  evidenceItems       EvidenceItem[]
  creativeBrief       CreativeBrief?
  motherContent       MotherContent?
  platformVariants    PlatformVariant[]
  deepContentPackages DeepContentPackage[]
  aiRuns              AIRun[]
  reviewRecords       ReviewRecord[]
  publishTasks        PublishTask[]
  contentIdea         ContentIdea?
  recommendationItems RecommendationItem[]
  unifiedCreativeAnalyses UnifiedCreativeAnalysis[]
  methodSelections       ProjectMethodSelection[]
  methodUsages            MethodUsage[]
  creationFeedbacks      CreationFeedback[]
  canvasObjects          CanvasObject[]
  canvasSnapshots        CanvasObjectSnapshot[]
  canvasRelations        CanvasRelation[]
  canvasMaterialReferences CanvasMaterialReference[]
  draftBranches          DraftBranch[]      @relation("ProjectDraftBranches")
  draftRevisions         DraftRevision[]
  primaryDraftBranch     DraftBranch?       @relation("PrimaryDraftBranch", fields: [primaryDraftBranchId], references: [id], onDelete: SetNull)
  assistantThreads       AssistantThread[]
  artifacts              Artifact[]
  userPreferences          UserProjectPreference[]
  canvasGenerateRuns     CanvasGenerateRun[]

  @@index([workspaceId, createdAt])
  @@unique([workspaceId, createdById, clientRequestId])
  @@index([workspaceId, status])
  @@index([createdById])
  @@index([creatorProfileId])
}

model ProjectFolder {
  id          String                  @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences UserProjectPreference[]

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId, sortOrder])
}

model UserProjectPreference {
  id           String         @id @default(cuid())
  workspaceId  String
  userId       String
  projectId    String
  folderId     String?
  pinnedAt     DateTime?
  sortOrder    Int            @default(0)
  lastOpenedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
