# Copy to .env.local-test only after creating a dedicated local test database/Redis.
ENVIRONMENT_ID=LOCAL_TEST
APP_ENV=local-test
NODE_ENV=test
APP_URL=http://127.0.0.1:3001
PORT=3001
DATABASE_URL=postgresql://content_center_test:replace-me@127.0.0.1:55433/content_center_test?schema=public
REDIS_URL=redis://127.0.0.1:6380
STORAGE_DRIVER=S3_COMPATIBLE
S3_ENDPOINT=http://127.0.0.1:9002
S3_REGION=us-east-1
S3_BUCKET=content-center-test
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MOCK_MODE=true
SYSTEM_MANAGED_PROVIDERS=false
RUNTIME_GUARD=LOCAL_TEST
WORKER_HEALTH_URL=http://127.0.0.1:3011
WORKER_HEALTH_PORT=3011
LOCAL_ASR_ENDPOINT=http://127.0.0.1:8765
